# Copy this file to ".env" (npm run setup does it for you).
PORT=4000

# Used to sign login tokens. Change it to any long random string.
JWT_SECRET=change-this-to-a-long-random-string

# The address of the React app (used for CORS).
CLIENT_ORIGIN=http://localhost:5173

# Demo pace for item tracking: how long each stage lasts (milliseconds).
STAGE_DURATION_MS=20000
